# Projet Supabase : Project Settings → API (ou variables créées par l'intégration Vercel).
# Sans ces deux variables, l'application fonctionne en mode local (progression dans le navigateur).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-ou-publishable

# Affiche le bouton « Continuer avec GitHub » (fournisseur GitHub à activer dans Supabase).
VITE_AUTH_GITHUB=false

# Adresse du site, utilisée par les applis Android / iOS pour les liens reçus par e-mail.
VITE_SITE_URL=https://cardlearn.vercel.app
